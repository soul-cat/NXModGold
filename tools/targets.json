      "class": "HealthManager",
      "field": "hp",
      "required": true,
      "_note": "public int，当前血量"
    },
    {
      "name": "HM_INITHP",
      "class": "HealthManager",
      "field": "initHp",
      "required": true,
      "aliases": [
        "initHP"
      ],
      "_note": "private int，最大血量。没有 maxHP 这个名字"
    },
